{
  "name": "weekaboo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "native:setup": "node scripts/native-setup.mjs",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "desktop:dev": "npm run build:desktop && electron desktop/main.mjs",
    "dev": "vite --host 127.0.0.1 --port 5188",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5188",
    "test": "playwright test",
    "build:native": "tsc --noEmit && vite build --mode native",
    "android:sync": "sh scripts/android.sh sync",
    "android:debug": "sh scripts/android.sh debug",
    "android:bundle": "sh scripts/android.sh bundle",
    "android:release": "sh scripts/android.sh release",
    "ios:sync": "sh scripts/ios.sh sync",
    "ios:simulator": "sh scripts/ios.sh simulator",
    "desktop:package": "npm run build:desktop && node scripts/package-desktop.mjs",
    "desktop:dmg": "npm run desktop:package && node scripts/desktop-dmg.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "python3 -m http.server 5190 --bind 127.0.0.1 --directory dist-site",
    "version:sync": "node scripts/release-version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "ical.js": "2.2.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "parse5": "8.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@azure/msal-node": "6.0.0",
    "@capacitor/cli": "8.4.3",
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "google-auth-library": "11.0.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.6"
  },
  "weekabooBuild": 1,
  "license": "MIT"
}
