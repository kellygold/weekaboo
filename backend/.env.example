# Copy to .env; generate a private key with the setup script.
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=http://localhost:8080
FRONTEND_URL=http://127.0.0.1:5188
TIMEZONE=Australia/Sydney

# Microsoft Graph: app registration with personal + organization accounts.
# Paste the client secret VALUE, never the secret ID. Backend-only credentials.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Full snapshot: SYNC_PAST_DAYS (default 90) through this many days ahead.
MICROSOFT_SYNC_FUTURE_DAYS=365
